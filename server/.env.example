# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GroqApp
DB_USER=groq_app
DB_PASSWORD=your_database_password_here

# Secret used to sign login tokens (at least 32 random characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me

# Website address(es) allowed to call the API (separate several with commas)
CLIENT_ORIGIN=http://localhost:5173

# Optional: the port the API listens on (default 3000)
# PORT=3000